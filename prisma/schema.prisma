generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  // url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model User {
  id                    String                         @id @unique(map: "user_Id") @default(cuid())
  name                  String?
  email                 String?                        @unique
  emailVerified         DateTime?
  password              String?                        @db.VarChar(999)
  image                 String?
  last_online           DateTime                       @default(now()) @db.Timestamp(0)
  last_action           String?
  // The user's current location in the world (one at a time).
  currentLocationId     Int?
  level                 Int                            @default(1)
  // Total (lifetime) XP. Level is derived from `LevelXpThreshold`.
  // NOTE: existing DBs may have legacy "XP within level" values; code normalizes lazily.
  experience            BigInt                         @default(0)
  gold                  Decimal                        @default(0) @db.Decimal(10, 2)
  accounts              Account[]
  equipment             Equipment?
  inventory             Inventory?
  sessions              Session[]
  user_skills           user_skills[]
  baseStats             CharacterBaseStat[]
  xpMultipliers         XpMultiplier[]
  userItems             UserItem[]
  trackProgress         UserTrackProgress[]
  skillMetrics          UserSkillMetric[]
  vocationalActivity    UserVocationalActivity?
  travelActivity        UserTravelActivity?
  gardenTiles           UserGardenTile[]
  gardenHarvestActivity UserGardenHarvestActivity?
  gatheringExpedition   UserGatheringExpedition?
  huntingExpedition     UserHuntingExpedition?
  dungeonRun            UserDungeonRun?
  healthState           CharacterHealth?
  learnedRecipes        UserLearnedRecipe[]
  activeFoodEffect      UserActiveFoodEffect?
  marketBuyOrders       MarketBuyOrder[]
  marketPurchases       MarketTransaction[]            @relation("MarketTransactionBuyer")
  marketSales           MarketTransaction[]            @relation("MarketTransactionSeller")
  quests                UserQuest[]
  seenQuests            UserSeenQuest[]
  storages              UserStorage[]
  projectContributions  CommunityProjectContribution[]
  notifications         Notification[]
  conversations         ConversationParticipant[]
  messagesSent          Message[]
  reportsFiled          MessageReport[]                @relation("MessageReportReporter")
  reportsAgainst        MessageReport[]                @relation("MessageReportReported")
  reportsReviewed       MessageReport[]                @relation("MessageReportReviewer")

  currentLocation Location? @relation("UserCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([experience])
  @@index([currentLocationId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Base_Items {
  id          Int    @id @default(autoincrement())
  name        String @db.Text
  description String @db.Text
}

model Base_Items_M {
  id           Int     @id @default(autoincrement())
  name         String? @db.VarChar(255)
  min_ad       Float?  @db.Float
  max_ad       Float?  @db.Float
  attack_speed Float?  @db.Float
  armor        Float?  @db.Float
  sprite       String? @db.Text
}

model Example {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime
}

enum ItemRarity {
  WORTHLESS
  BROKEN
  COMMON
  UNCOMMON
  RARE
  EXQUISITE
  EPIC
  ELITE
  UNIQUE
  LEGENDARY
  MYTHIC
  DIVINE
}

enum ItemType {
  // Weapon Types
  SWORD
  GREATSWORD
  AXE
  GREATAXE
  FELLING_AXE
  PICKAXE
  FISHING_ROD
  HOE
  BOW
  CROSSBOW
  STAFF
  WAND
  DAGGER
  MACE
  SPEAR
  FLAIL
  SHIELD

  // Armor Types
  HELMET
  CHESTPLATE
  GREAVES
  BOOTS
  GLOVES
  PAULDRONS
  BRACERS
  BELT

  // Accessory Types
  RING
  AMULET
  NECKLACE

  // Backpack/Storage
  BACKPACK

  // Resource Types
  ORE
  INGOT
  LOG
  HERB
  FISH
  BAIT
  HIDE
  STONE
  GEM

  // Consumable Types
  POTION
  FOOD
  ELIXIR
  SCROLL

  // Gardening
  SEED

  // Crafting Types
  MATERIAL
  MEAT
  VEGETABLE
  RECIPE
  BLUEPRINT

  // Special Types
  QUEST_ITEM
  KEY
  CURRENCY
  PET
  MOUNT

  // Misc
  OTHER
}

// Per-unit material requirements for a vocational resource output.
// Example: BLACKSMITHING "Iron Bar" might require 1x Iron Ore per unit.
model VocationalRequirement {
  id              Int @id @default(autoincrement())
  resourceId      Int
  itemId          Int
  quantityPerUnit Int @default(1)

  resource VocationalResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  item     Item               @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([resourceId, itemId])
  @@index([resourceId])
  @@index([itemId])
}

enum StatType {
  // Offensive Stats
  PHYSICAL_DAMAGE_MIN
  PHYSICAL_DAMAGE_MAX
  MAGIC_DAMAGE_MIN
  MAGIC_DAMAGE_MAX
  CRITICAL_CHANCE
  CRITICAL_DAMAGE
  ATTACK_SPEED
  ACCURACY

  // Defensive Stats
  ARMOR
  MAGIC_RESIST
  EVASION_MELEE
  EVASION_RANGED
  EVASION_MAGIC
  BLOCK_CHANCE

  // Resistances
  FIRE_RESIST
  COLD_RESIST
  LIGHTNING_RESIST
  POISON_RESIST

  // Character Resources
  HEALTH
  MANA
  HEALTH_REGEN
  MANA_REGEN

  // Special Stats
  PRAYER_POINTS
  MOVEMENT_SPEED
  LUCK
  GOLD_FIND
  EXPERIENCE_GAIN
  LIFESTEAL
  THORNS
  CARRYING_CAPACITY

  // Vocation/tool stats
  WOODCUTTING_EFFICIENCY
  MINING_EFFICIENCY
  FISHING_EFFICIENCY
  GATHERING_EFFICIENCY
  HUNTING_EFFICIENCY
}

// Constrained set of equipment-slot targets for Item templates.
// This is stored as a MySQL ENUM so tools like phpMyAdmin present a dropdown.
enum ItemEquipTo {
  head
  necklace
  chest
  pauldrons
  bracers
  gloves
  greaves
  boots
  belt
  ring
  amulet
  backpack
  weapon
  offhand
  fellingAxe
  pickaxe
  fishingRod
  hoe
}

model Item {
  id          Int     @id @default(autoincrement())
  name        String
  description String? @db.Text
  price       Float
  sprite      String

  // Item categorization
  itemType ItemType? // Specific type (SWORD, ORE, POTION, etc) - nullable for now
  equipTo  ItemEquipTo? // Equipment slot (weapon, chest, etc) - nullable

  // Weapons only: a two-handed weapon takes the main hand and keeps the off hand empty.
  twoHanded Boolean @default(false)

  // Stacking system
  stackable    Boolean @default(false)
  maxStackSize Int     @default(1)

  // Seed / gardening configuration (only used when itemType = SEED)
  seedGrowSeconds    Int?
  seedYieldItemId    Int?
  seedYieldMin       Int?
  seedYieldMax       Int?
  seedHarvestSeconds Int?
  seedXp             Int?

  // Timed character bonuses applied by FOOD, POTION, or ELIXIR consumables.
  foodEffectSeconds Int?

  // If enabled, negative stats (e.g. MOVEMENT_SPEED -5) will become less negative
  // and eventually positive as rarity multipliers increase.
  flipNegativeStatsWithRarity Boolean @default(false)

  vocationalRequirements VocationalRequirement[]

  rarity ItemRarity @default(COMMON)

  // Denormalized columns for fast marketplace queries
  minPhysicalDamage Float? @default(0)
  maxPhysicalDamage Float? @default(0)
  minMagicDamage    Float? @default(0)
  maxMagicDamage    Float? @default(0)
  armor             Float? @default(0)
  requiredLevel     Int?   @default(1)

  // Relationships
  stats                ItemStat[]
  statProgressions     ItemStatProgression[] // Defines stats at each rarity tier
  statRarityOverrides  ItemStatRarityOverride[] // Optional item/stat-specific multiplier or final-value overrides
  toolEfficiencies     ToolEfficiency[] // Base efficiencies per vocation tool
  creatureDrops        CreatureDrop[]
  userItems            UserItem[] // Item instances owned by players
  marketBuyOrders      MarketBuyOrder[]
  marketTransactions   MarketTransaction[]
  vocationalResource   VocationalResource?           @relation("VocationalOutputItem")
  requiredByRecipes    VocationalResource[]          @relation("RequiredRecipeItem")
  learnedRecipeRecords UserLearnedRecipe[]
  foodEffectStats      FoodEffectStat[]
  activeFoodEffects    UserActiveFoodEffect[]
  npcOffers            NpcOffer[]
  questObjectives      QuestObjective[]
  questRewards         QuestRewardItem[]
  projectRequirements  CommunityProjectRequirement[]

  seedYieldItem Item?  @relation("SeedYieldItem", fields: [seedYieldItemId], references: [id], onDelete: SetNull)
  seedYieldedBy Item[] @relation("SeedYieldItem")

  gardenSeedTiles  UserGardenTile[] @relation("GardenSeedItem")
  gardenYieldTiles UserGardenTile[] @relation("GardenYieldItem")

  @@index([minPhysicalDamage])
  @@index([maxPhysicalDamage])
  @@index([minMagicDamage])
  @@index([armor])
  @@index([requiredLevel])
  @@index([rarity])
}

// ============================================
// GARDENING (TILES)
// ============================================

model UserGardenTile {
  id        Int    @id @default(autoincrement())
  userId    String
  tileIndex Int

  seedItemId Int
  plantedAt  DateTime @default(now())
  readyAt    DateTime

  // Cached yield configuration for UI + balance; RNG is rolled at harvest completion.
  yieldItemId Int
  yieldMin    Int
  yieldMax    Int

  harvestSeconds Int

  // Snapshot of Gardening XP earned when this crop is collected.
  xpReward Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  seedItem  Item @relation("GardenSeedItem", fields: [seedItemId], references: [id], onDelete: Restrict)
  yieldItem Item @relation("GardenYieldItem", fields: [yieldItemId], references: [id], onDelete: Restrict)

  @@unique([userId, tileIndex])
  @@index([userId])
  @@index([readyAt])
}

// One active garden harvest per user.
// While active, the user cannot interact with the garden or start other actions.
model UserGardenHarvestActivity {
  id     Int    @id @default(autoincrement())
  userId String @unique

  startedAt DateTime @default(now())
  endsAt    DateTime

  // Snapshot of the selection at start.
  tiles Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([endsAt])
  @@index([userId, endsAt])
}

enum ItemStatRarityOverrideKind {
  MULTIPLIER
  ABSOLUTE
}

// Optional item/stat-specific balance control for one rarity.
// MULTIPLIER replaces the global rarity multiplier; ABSOLUTE sets the final base value.
model ItemStatRarityOverride {
  id       Int                        @id @default(autoincrement())
  itemId   Int
  statType StatType
  rarity   ItemRarity
  kind     ItemStatRarityOverrideKind @default(ABSOLUTE)
  value    Float

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, statType, rarity])
  @@index([itemId, rarity])
}

model ItemStat {
  id       Int      @id @default(autoincrement())
  itemId   Int
  statType StatType
  value    Float
  // Optional upper cap applied after rarity scaling.
  // Example: MOVEMENT_SPEED -5 with maxValue -1 will never exceed -1.
  maxValue Float?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, statType])
  @@index([statType, value])
}

// Stat progression - defines which stats unlock at which rarity
// This ensures all items of the same type and rarity have identical stats
model ItemStatProgression {
  id              Int        @id @default(autoincrement())
  itemId          Int
  statType        StatType
  baseValue       Float // Base value at COMMON rarity
  unlocksAtRarity ItemRarity // When this stat becomes available

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, statType])
  @@index([itemId, unlocksAtRarity])
}

// ============================================
// USER ITEM INSTANCES
// ============================================

// ============================================
// VOCATIONAL TOOL EFFICIENCY
// ============================================

model ToolEfficiency {
  id             Int                  @id @default(autoincrement())
  itemId         Int
  actionType     VocationalActionType // Which vocation this tool boosts
  baseEfficiency Float // Base percent at COMMON rarity

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, actionType])
  @@index([actionType])
}

enum ItemStatus {
  IN_INVENTORY // In player's inventory
  IN_STORAGE // In one of the player's settlement storages
  EQUIPPED // Currently equipped
  LISTED // On marketplace
  SOLD // Sold (historical record)
  DELETED // Deleted/destroyed
}

enum MarketOrderStatus {
  OPEN
  FILLED
  CANCELLED
}

enum MarketTransactionSource {
  BUY_NOW
  SELL_NOW
}

// Player-owned item instances. Rarity and instance modifiers are unique;
// template-derived balance stats are resolved live.
model UserItem {
  id     Int        @id @default(autoincrement())
  userId String
  itemId Int // Reference to Item template
  rarity ItemRarity @default(COMMON)

  // Stacking - for stackable items only
  quantity Int @default(1)

  // Item location/status
  status ItemStatus @default(IN_INVENTORY)

  // Marketplace data (only when status = LISTED)
  listedPrice Float? // Listing price in gold
  listedAt    DateTime? // When listed

  // The player's settlement storage holding it, while status = IN_STORAGE.
  userStorageId Int?

  // Metadata
  acquiredAt  DateTime @default(now())
  isTradeable Boolean  @default(true)

  // Relationships
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemTemplate  Item                   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // Additive per-instance modifiers only (future enchantments, affixes, etc.).
  // Template and rarity-derived stats are resolved live and are never copied here.
  statModifiers UserItemStatModifier[]

  storage UserStorage? @relation(fields: [userStorageId], references: [id], onDelete: Cascade)

  baitForActivities UserVocationalActivity[] @relation("BaitUserItem")

  @@index([userId])
  @@index([itemId])
  @@index([status])
  @@index([status, listedAt])
  @@index([userId, status])
  @@index([userStorageId])
}

// Gold is reserved when an order is created and refunded if its remainder is cancelled.
// Buy orders intentionally target exact item + rarity combinations and are limited to
// stackable items; individually rolled equipment continues to trade as exact listings.
model MarketBuyOrder {
  id                Int               @id @default(autoincrement())
  userId            String
  itemId            Int
  rarity            ItemRarity
  quantity          Int
  remainingQuantity Int
  pricePerItem      Decimal           @db.Decimal(10, 2)
  reservedGold      Decimal           @db.Decimal(10, 2)
  status            MarketOrderStatus @default(OPEN)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([itemId, rarity, status, pricePerItem, createdAt])
}

// Immutable executions are the source of truth for price history and player history.
model MarketTransaction {
  id          Int                     @id @default(autoincrement())
  buyerId     String?
  sellerId    String?
  itemId      Int
  rarity      ItemRarity
  quantity    Int
  unitPrice   Decimal                 @db.Decimal(10, 2)
  grossAmount Decimal                 @db.Decimal(10, 2)
  taxAmount   Decimal                 @db.Decimal(10, 2)
  netAmount   Decimal                 @db.Decimal(10, 2)
  source      MarketTransactionSource
  executedAt  DateTime                @default(now())

  buyer  User? @relation("MarketTransactionBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  seller User? @relation("MarketTransactionSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  item   Item  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([itemId, rarity, executedAt])
  @@index([buyerId, executedAt])
  @@index([sellerId, executedAt])
}

// Additive stat adjustments unique to one item instance.
// Base item and rarity stats remain live on the shared Item balance definition.
model UserItemStatModifier {
  id         Int      @id @default(autoincrement())
  userItemId Int
  statType   StatType
  value      Float

  userItem UserItem @relation(fields: [userItemId], references: [id], onDelete: Cascade)

  @@unique([userItemId, statType])
  @@index([userItemId])
  @@map("UserItemStat")
}

// Per-character additions on top of the level-scaled base stats (for example
// future quest rewards). Level-derived values are never stored here.
model CharacterBaseStat {
  id       Int      @id @default(autoincrement())
  userId   String
  statType StatType
  value    Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, statType])
  @@index([userId])
}

// Admin-tuned level scaling of character base stats, resolved live from each
// character's level so edits apply to every existing character. Stats without
// a row use the defaults in src/utils/stats.ts.
model CharacterStatGrowth {
  id        Int      @id @default(autoincrement())
  statType  StatType @unique
  // Value at level 1.
  baseValue Float
  // Added for every level above 1.
  perLevel  Float    @default(0)
  // Ceiling on the total level bonus; null means no ceiling.
  maxBonus  Float?
  updatedAt DateTime @updatedAt
}

model Inventory {
  id           Int    @id @default(autoincrement())
  maxSlots     Int    @default(25)
  userId       String @unique
  slots        Json // Stores { slotIndex: number, item: { id: number } | null }[]
  deleteSlotId Int? // UserItem ID in the delete slot (nullable)
  User         User   @relation(fields: [userId], references: [id])
}

model Equipment {
  id     Int    @id @default(autoincrement())
  userId String @unique

  // UserItem instance IDs (player-specific items with unique rarity/stats)
  headItemId       Int?
  chestItemId      Int?
  beltItemId       Int?
  greavesItemId    Int?
  bootsItemId      Int?
  necklaceItemId   Int?
  ring1ItemId      Int?
  ring2ItemId      Int?
  amuletItemId     Int?
  pauldronsItemId  Int?
  bracersItemId    Int?
  glovesItemId     Int?
  backpackItemId   Int?
  weaponItemId     Int?
  offhandItemId    Int?
  fellingAxeItemId Int?
  pickaxeItemId    Int?
  fishingRodItemId Int?
  hoeItemId        Int?

  User User @relation(fields: [userId], references: [id])
}

model Modifiers {
  id        Int    @id @default(autoincrement())
  name      String @db.VarChar(255)
  code      String @db.VarChar(255)
  mod_range String @db.VarChar(255)
}

enum SkillCategory {
  VOCATION
  CRAFTING
}

model skills {
  skill_id    Int           @id @default(autoincrement())
  skill_name  String        @unique(map: "skill_name")
  description String?       @db.Text
  category    SkillCategory @default(VOCATION)
  user_skills user_skills[]
}

model user_skills {
  user_skill_id Int      @id @default(autoincrement())
  user_id       String
  skill_id      Int
  level         Int      @default(1)
  current_xp    Int      @default(0)
  updated_at    DateTime @default(now()) @db.Timestamp(0)
  skills        skills   @relation(fields: [skill_id], references: [skill_id], onUpdate: Restrict, map: "user_skills_ibfk_1")
  User          User     @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "user_skills_ibfk_2")

  @@unique([user_id, skill_id], map: "user_id")
  @@index([skill_id], map: "skill_id")
}

// A consumed RECIPE item permanently unlocks linked recipes for a user.
// Physical BLUEPRINT items are ordinary VocationalRequirement inputs instead.
model UserLearnedRecipe {
  id           Int      @id @default(autoincrement())
  userId       String
  recipeItemId Int
  learnedAt    DateTime @default(now())

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeItem Item @relation(fields: [recipeItemId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeItemId])
  @@index([userId])
  @@index([recipeItemId])
}

model FoodEffectStat {
  id       Int      @id @default(autoincrement())
  itemId   Int
  statType StatType
  value    Float

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, statType])
  @@index([itemId])
}

// Only one timed consumable effect can be active at once; another replaces it.
model UserActiveFoodEffect {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  itemId    Int
  startedAt DateTime @default(now())
  endsAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([endsAt])
  @@index([itemId])
}

// ============================================
// LEVELING SYSTEM
// ============================================

// XP Configuration - Single source of truth for XP curves
model XpConfig {
  id         Int     @id @default(autoincrement())
  configName String  @unique // e.g., "default", "season1", "hardmode"
  isActive   Boolean @default(false) // Only one config can be active

  // Base XP formula parameters
  baseXp             Float @default(100) // XP needed for level 2
  exponentMultiplier Float @default(1.5) // Controls curve steepness
  levelMultiplier    Float @default(1.0) // Additional scaling per level

  // Level brackets with different difficulty
  easyLevelCap   Int   @default(5) // Levels 1-5: easy
  easyMultiplier Float @default(0.8) // 80% of normal XP

  normalLevelCap   Int   @default(15) // Levels 6-15: normal
  normalMultiplier Float @default(1.0) // 100% of normal XP

  hardLevelCap   Int   @default(30) // Levels 16-30: hard
  hardMultiplier Float @default(1.3) // 130% of normal XP

  veryHardLevelCap   Int   @default(50) // Levels 31-50: very hard
  veryHardMultiplier Float @default(1.8) // 180% of normal XP

  extremeLevelCap   Int   @default(62) // Levels 51-62: extreme
  extremeMultiplier Float @default(3.0) // 300% of normal XP

  // Soft cap system (nearly impossible to level past this)
  softCapLevel      Int   @default(62)
  softCapMultiplier Float @default(10.0) // 1000% of normal XP (almost impossible)

  // Hard cap (absolute maximum level)
  hardCapLevel Int @default(70)

  // Seasonal/event settings
  seasonalBonus Float @default(0) // Global XP bonus (0 = none, 0.1 = 10% more)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// XP Multipliers (temporary boosts from items, events, etc.)
model XpMultiplier {
  id     Int    @id @default(autoincrement())
  userId String

  name       String // e.g., "XP Boost Card", "Weekend Event"
  multiplier Float // 1.1 = 10% more XP, 2.0 = 100% more XP

  // Optional: specific action types
  actionType           XpActionType? // null = applies to all XP actions
  vocationalActionType VocationalActionType? // only used when actionType = VOCATION (null = all vocations)

  // Duration
  expiresAt     DateTime? // null = permanent until manually removed
  usesRemaining Int? // null = unlimited uses

  isActive  Boolean @default(true)
  stackable Boolean @default(true) // Can stack with other multipliers

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive, expiresAt])
  @@index([expiresAt])
  @@index([actionType])
  @@index([vocationalActionType])
}

// Types of actions that give XP
enum XpActionType {
  QUEST
  DUNGEON
  TRAVELING
  VOCATION
}

// Generic progression tracks (separate XP/levels per system)
enum ProgressionTrackType {
  SKILL
  VOCATION
  DUNGEON
  COMBAT
}

// ============================================
// ITEM RARITY SYSTEM
// ============================================

// Rarity multipliers configuration
model RarityConfig {
  id     Int        @id @default(autoincrement())
  rarity ItemRarity @unique

  // Stat multiplier (e.g., 1.0 = 100%, 2.0 = 200%)
  statMultiplier Float @default(1.0)

  // Max number of stats this rarity can have
  minStats Int @default(1)
  maxStats Int @default(3)

  // Additional bonus stats for higher rarities
  bonusStatChance Float @default(0) // 0-1 (0% to 100% chance for extra stat)

  // Visual/Display
  color       String @default("#ffffff")
  displayName String
  sortOrder   Int    @default(0) // For sorting in UI

  // Upgrade system
  upgradeEnabled Boolean     @default(true)
  nextRarity     ItemRarity?
  upgradeCost    Int? // Cost to upgrade to next rarity

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rarity])
}

// XP Transaction Log (for debugging and analytics)
model XpTransaction {
  id     Int    @id @default(autoincrement())
  userId String

  amount               BigInt // Base XP amount (integer)
  finalAmount          BigInt // After all multipliers (integer)
  actionType           XpActionType // top-level XP source
  vocationalActionType VocationalActionType? // required when actionType = VOCATION

  // Multipliers applied
  baseMultiplier   Float @default(1.0)
  itemMultipliers  Json? // Array of applied item multipliers
  eventMultipliers Json? // Array of applied event multipliers

  // Level context
  levelBefore      Int
  levelAfter       Int
  experienceBefore BigInt
  experienceAfter  BigInt

  // Optional context
  description String? // e.g., "Killed Goblin", "Completed Quest: Save the Village"
  metadata    Json? // Any additional data

  createdAt DateTime @default(now())

  // Nothing queries this table - it is a write-only audit log - so it carried
  // 92% index overhead purely as insert cost. Only the per-player lookup is
  // kept, for a future history view.
  @@index([userId, createdAt])
}

// Defines the cumulative total XP required to reach each level.
// Example: if level 2 starts at 6 XP, then row { level: 2, xpTotal: 6 }.
model LevelXpThreshold {
  level   Int    @id
  xpTotal BigInt @unique

  @@index([xpTotal])
}

// Defines the cumulative total XP required to reach each level for a given track.
// Example: if level 2 starts at 60 XP for SKILL, then row { trackType: SKILL, level: 2, xpTotal: 60 }.
model TrackXpThreshold {
  trackType ProgressionTrackType
  level     Int
  xpTotal   BigInt

  @@id([trackType, level])
  @@index([trackType, xpTotal])
}

// Stores a user's XP/level for a given track key (e.g. SKILL + "WOODCUTTING").
model UserTrackProgress {
  id        Int                  @id @default(autoincrement())
  userId    String
  trackType ProgressionTrackType
  trackKey  String

  level      Int    @default(1)
  experience BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackType, trackKey])
  @@index([userId, trackType])
}

// Lifetime totals shown on a skill page. Experience is not duplicated here: it
// is read from UserTrackProgress. Counting starts when a skill is first used.
model UserSkillMetric {
  userId     String
  actionType VocationalActionType

  itemsGathered BigInt   @default(0)
  secondsSpent  BigInt   @default(0)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, actionType])
}

// ============================================
// VOCATIONAL (OFFLINE) ACTIONS
// ============================================

enum VocationalActionType {
  WOODCUTTING
  MINING
  FISHING
  GARDENING
  GATHERING
  HUNTING
  ALCHEMY
  BLACKSMITHING
  WEAPONSMITHING
  CARPENTRY
  COOKING
  TAILORING
  FORGE
}

model Location {
  id                     Int      @id @default(autoincrement())
  name                   String   @unique
  requiredLevel          Int      @default(1)
  gatheringEnabled       Boolean  @default(false)
  gatheringRequiredLevel Int      @default(1)
  // Region map artwork (1536x1024) with its places pinned on it.
  mapImage               String?
  // Pin on the world atlas, in percent; unplaced when null.
  mapX                   Float?
  mapY                   Float?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  resources            LocationVocationalResource[]
  activities           UserVocationalActivity[]
  gatheringExpeditions UserGatheringExpedition[]
  huntingGrounds       HuntingGround[]
  dungeons             Dungeon[]
  settlements          Settlement[]
  users                User[]                       @relation("UserCurrentLocation")

  travelFrom UserTravelActivity[] @relation("TravelFrom")
  travelTo   UserTravelActivity[] @relation("TravelTo")

  travelRoutesA TravelRoute[] @relation("TravelRouteA")
  travelRoutesB TravelRoute[] @relation("TravelRouteB")
}

// The world atlas artwork (1536x1024) every player sees on /map; one row
// (id 1). Locations are pinned on it with their mapX/mapY.
model AtlasConfig {
  id        Int      @id @default(1)
  mapImage  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// TRAVEL
// ============================================

// Optional: keeps global travel duration in the DB.
// If you never create a row, code falls back to 4 hours.
model TravelConfig {
  id               Int      @id @default(autoincrement())
  // Base time for a location pair without a TravelRoute row.
  secondsPerTravel Int      @default(14400) // 4 hours
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Base travel time between two locations at 100% movement speed. Routes are
// undirected: stored once with the lower location id as A.
model TravelRoute {
  id          Int      @id @default(autoincrement())
  locationAId Int
  locationBId Int
  seconds     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locationA Location @relation("TravelRouteA", fields: [locationAId], references: [id], onDelete: Cascade)
  locationB Location @relation("TravelRouteB", fields: [locationBId], references: [id], onDelete: Cascade)

  @@unique([locationAId, locationBId])
  @@index([locationBId])
}

// One active travel per user.
model UserTravelActivity {
  id             Int    @id @default(autoincrement())
  userId         String @unique
  fromLocationId Int?
  toLocationId   Int

  startedAt   DateTime  @default(now())
  endsAt      DateTime
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromLocation Location? @relation("TravelFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location  @relation("TravelTo", fields: [toLocationId], references: [id], onDelete: Restrict)

  @@index([endsAt])
  @@index([userId, endsAt])
}

// A resource that can be produced by a vocational action (e.g. Coal for MINING)
// Links to an Item template which is granted as the reward.
model VocationalResource {
  id         Int                  @id @default(autoincrement())
  actionType VocationalActionType
  name       String
  itemId     Int                  @unique

  // Optional RECIPE item which must be learned before this craft is visible/startable.
  // Physical BLUEPRINT items belong in requirements; null keeps starter recipes available.
  requiredRecipeItemId Int?

  // Skill-gating: minimum SKILL track level for this actionType
  requiredSkillLevel Int @default(1)

  // Balance knobs (DB-driven)
  defaultSeconds Int        @default(10) // seconds per 1 unit, before tool/buff modifiers
  yieldPerUnit   Int        @default(1)
  xpPerUnit      Int        @default(0) // XP granted per completed unit (1 action tick)
  rarity         ItemRarity @default(COMMON)

  // Display order within the action type, lowest first. Admin-managed on /admin/vocations.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item               Item                         @relation("VocationalOutputItem", fields: [itemId], references: [id], onDelete: Cascade)
  requiredRecipeItem Item?                        @relation("RequiredRecipeItem", fields: [requiredRecipeItemId], references: [id], onDelete: SetNull)
  locations          LocationVocationalResource[]
  activities         UserVocationalActivity[]
  requirements       VocationalRequirement[]

  @@index([actionType, sortOrder])
  @@index([requiredRecipeItemId])
}

// Location-specific configuration (overrides defaultSeconds per location)
model LocationVocationalResource {
  id         Int @id @default(autoincrement())
  locationId Int
  resourceId Int

  enabled Boolean @default(true)

  // Expedition-only balance knobs. Other vocations ignore these values.
  gatheringBaseChance  Float @default(0.25)
  gatheringMinQuantity Int   @default(1)
  gatheringMaxQuantity Int   @default(1)

  location Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resource VocationalResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([locationId, resourceId])
  @@index([locationId])
  @@index([resourceId])
}

// Admin-configured expedition choices. Duration controls the number of find
// rolls, quantity scaling and XP without hardcoding balance into the client.
model GatheringDuration {
  id                     Int      @id @default(autoincrement())
  label                  String   @unique
  durationSeconds        Int      @unique
  rewardRolls            Int      @default(3)
  quantityMultiplier     Float    @default(1)
  xpReward               Int      @default(0)
  requiredGatheringLevel Int      @default(0)
  enabled                Boolean  @default(true)
  sortOrder              Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  expeditions UserGatheringExpedition[]

  @@index([enabled, sortOrder])
}

// One expedition record per character. Claimed records remain until the next
// departure so the return haul can be shown after refresh without a history table.
model UserGatheringExpedition {
  id         Int    @id @default(autoincrement())
  userId     String @unique
  locationId Int
  durationId Int?

  startedAt DateTime  @default(now())
  endsAt    DateTime
  claimedAt DateTime?

  // Departure-time snapshots keep in-flight expeditions stable across admin edits.
  durationSeconds             Int
  rewardRolls                 Int
  quantityMultiplier          Float
  xpReward                    Int
  skillLevelSnapshot          Int
  luckSnapshot                Float
  gatheringEfficiencySnapshot Float
  rewardPool                  Json
  rewards                     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  duration GatheringDuration? @relation(fields: [durationId], references: [id], onDelete: SetNull)

  @@index([endsAt])
  @@index([locationId])
  @@index([durationId])
}

// ============================================
// CREATURES, HUNTING, AND CHARACTER HEALTH
// ============================================

// Shared creature taxonomy. Hunting uses ANIMAL rows; dungeons use MONSTER
// rows. Both share assets, combat fields and the drop table.
enum CreatureKind {
  ANIMAL
  MONSTER
}

enum CreatureAttackStyle {
  MELEE
  RANGED
  MAGIC
}

// Optional elemental rider on a creature's attack, reduced by the matching
// character resistance (ICE uses Cold Resistance).
enum CreatureDamageType {
  FIRE
  ICE
  LIGHTNING
  POISON
}

model Creature {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?      @db.Text
  kind        CreatureKind @default(ANIMAL)
  asset       String
  enabled     Boolean      @default(true)

  // Attack profile, used by dungeon combat and Hunting retaliation.
  // attackStyle selects the evasion stat that can avoid a strike. Physical
  // damage (damageMin/damageMax) is reduced by armor, magic damage by magic
  // resistance, and elemental damage by the matching resistance.
  // Percentages use the character stat scale (crit damage 150 = x1.5).
  attackStyle        CreatureAttackStyle @default(MELEE)
  // Hunting only: chance an animal retaliates during an encounter.
  attackChance       Float               @default(0)
  damageMin          Int                 @default(0)
  damageMax          Int                 @default(0)
  magicDamageMin     Int                 @default(0)
  magicDamageMax     Int                 @default(0)
  damageType         CreatureDamageType?
  elementalDamageMin Int                 @default(0)
  elementalDamageMax Int                 @default(0)
  critChance         Float               @default(0)
  critDamage         Float               @default(0)

  // Defensive profile, used by dungeon combat only.
  health      Int   @default(0)
  armor       Float @default(0)
  magicResist Float @default(0)
  evasion     Float @default(0)
  blockChance Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drops           CreatureDrop[]
  huntingGrounds  HuntingGroundCreature[]
  dungeons        DungeonMonster[]
  questObjectives QuestObjective[]

  @@index([kind, enabled])
}

// A reusable creature loot table. Item rarity remains owned by Item, keeping
// granted stacks consistent with every other item source in the game.
model CreatureDrop {
  id         Int @id @default(autoincrement())
  creatureId Int
  itemId     Int

  enabled       Boolean @default(true)
  baseChance    Float   @default(0.5)
  minQuantity   Int     @default(1)
  maxQuantity   Int     @default(1)
  // Interpreted by the activity exposing the loot table: Hunting skill level
  // for animals, character level for dungeon monsters.
  requiredLevel Int     @default(1)

  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([creatureId, itemId])
  @@index([creatureId, enabled])
  @@index([itemId])
}

// A player-selectable hunting sub-location inside a world Location.
model HuntingGround {
  id         Int @id @default(autoincrement())
  locationId Int

  name                 String
  description          String? @db.Text
  requiredHuntingLevel Int     @default(1)
  enabled              Boolean @default(true)
  sortOrder            Int     @default(0)
  // Pin on the location's region map, in percent; unplaced when null.
  mapX                 Float?
  mapY                 Float?

  // Non-creature mishaps such as falls or weapon-handling accidents. This is
  // rolled once per encounter, so longer expeditions naturally carry more risk.
  accidentChance    Float @default(0)
  accidentDamageMin Int   @default(0)
  accidentDamageMax Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location    Location                @relation(fields: [locationId], references: [id], onDelete: Cascade)
  creatures   HuntingGroundCreature[]
  expeditions UserHuntingExpedition[]

  @@unique([locationId, name])
  @@index([locationId, enabled, sortOrder])
}

model HuntingGroundCreature {
  id              Int     @id @default(autoincrement())
  groundId        Int
  creatureId      Int
  enabled         Boolean @default(true)
  encounterWeight Float   @default(1)

  ground   HuntingGround @relation(fields: [groundId], references: [id], onDelete: Cascade)
  creature Creature      @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@unique([groundId, creatureId])
  @@index([groundId, enabled])
  @@index([creatureId])
}

model HuntingDuration {
  id                   Int      @id @default(autoincrement())
  label                String   @unique
  durationSeconds      Int      @unique
  encounterRolls       Int      @default(2)
  quantityMultiplier   Float    @default(1)
  dangerMultiplier     Float    @default(1)
  xpReward             Int      @default(0)
  requiredHuntingLevel Int      @default(1)
  enabled              Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  expeditions UserHuntingExpedition[]

  @@index([enabled, sortOrder])
}

// Singleton-style global guardrails. Fine-grained danger remains on creatures,
// grounds, and durations; these values let admins disable or cap it instantly.
model HuntingConfig {
  id                            Int      @id @default(1)
  damageEnabled                 Boolean  @default(true)
  globalDangerMultiplier        Float    @default(1)
  maxHealthLossPercent          Float    @default(30)
  minimumRemainingHealthPercent Float    @default(5)
  minimumHealthToStartPercent   Float    @default(25)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

// One record is retained after claim so the return journal survives refresh.
// All balance inputs are snapshotted at departure, like Gathering expeditions.
model UserHuntingExpedition {
  id         Int    @id @default(autoincrement())
  userId     String @unique
  groundId   Int
  durationId Int?

  startedAt DateTime  @default(now())
  endsAt    DateTime
  claimedAt DateTime?

  durationSeconds           Int
  encounterRolls            Int
  quantityMultiplier        Float
  dangerMultiplier          Float
  xpReward                  Int
  skillLevelSnapshot        Int
  luckSnapshot              Float
  huntingEfficiencySnapshot Float

  armorSnapshot           Float
  magicResistSnapshot     Float
  evasionMeleeSnapshot    Float
  evasionRangedSnapshot   Float
  evasionMagicSnapshot    Float
  blockChanceSnapshot     Float
  movementSpeedSnapshot   Float
  maxHealthSnapshot       Float
  // Added with elemental retaliation; older hunts resolve with no resistance.
  fireResistSnapshot      Float @default(0)
  coldResistSnapshot      Float @default(0)
  lightningResistSnapshot Float @default(0)
  poisonResistSnapshot    Float @default(0)

  resolutionSeed String
  creaturePool   Json
  riskConfig     Json
  rewards        Json?
  report         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ground   HuntingGround    @relation(fields: [groundId], references: [id], onDelete: Restrict)
  duration HuntingDuration? @relation(fields: [durationId], references: [id], onDelete: SetNull)

  @@index([endsAt])
  @@index([groundId])
  @@index([durationId])
}

// ============================================
// DUNGEONS
// ============================================

// Admin-set label shown to players. Actual danger comes from the monsters.
enum DungeonDifficulty {
  EASY
  NORMAL
  HARD
  DEADLY
}

// A timed, lethal PvE run inside a world Location. The dungeon grants XP only;
// every item comes from the drop tables of the monsters defeated inside it.
model Dungeon {
  id         Int @id @default(autoincrement())
  locationId Int

  name            String
  description     String?           @db.Text
  difficulty      DungeonDifficulty @default(NORMAL)
  // Character level.
  requiredLevel   Int               @default(1)
  durationSeconds Int               @default(1800)
  // How many monsters fight the character at once (1 = one at a time).
  packSize        Int               @default(1)
  xpReward        Int               @default(0)
  enabled         Boolean           @default(true)
  sortOrder       Int               @default(0)
  // Pin on the location's region map, in percent; unplaced when null.
  mapX            Float?
  mapY            Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location        Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  monsters        DungeonMonster[]
  runs            UserDungeonRun[]
  questObjectives QuestObjective[]

  @@unique([locationId, name])
  @@index([locationId, enabled, sortOrder])
}

// Monster population of a dungeon. Each run rolls a count in the range; the
// counts are never sent to players.
model DungeonMonster {
  id         Int     @id @default(autoincrement())
  dungeonId  Int
  creatureId Int
  enabled    Boolean @default(true)
  minCount   Int     @default(1)
  maxCount   Int     @default(1)

  dungeon  Dungeon  @relation(fields: [dungeonId], references: [id], onDelete: Cascade)
  creature Creature @relation(fields: [creatureId], references: [id], onDelete: Cascade)

  @@unique([dungeonId, creatureId])
  @@index([dungeonId, enabled])
  @@index([creatureId])
}

// Singleton-style global dungeon rules.
model DungeonConfig {
  id                          Int      @id @default(1)
  minimumHealthToStartPercent Float    @default(25)
  // On defeat, each looted stack survives with this chance (0-1) and keeps
  // this share of its quantity (minimum 1).
  deathLootKeepChance         Float    @default(0.35)
  deathLootQuantityPercent    Float    @default(25)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

// One record per character, retained after claim so the run journal survives
// refresh. Combat inputs are snapshotted at entry and resolved once at claim.
model UserDungeonRun {
  id        Int    @id @default(autoincrement())
  userId    String @unique
  dungeonId Int

  startedAt DateTime  @default(now())
  endsAt    DateTime
  claimedAt DateTime?

  durationSeconds Int
  xpReward        Int
  packSize        Int    @default(1)
  startingHealth  Float
  combatSnapshot  Json
  monsterPool     Json
  deathRules      Json
  resolutionSeed  String
  rewards         Json?
  report          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dungeon Dungeon @relation(fields: [dungeonId], references: [id], onDelete: Cascade)

  @@index([endsAt])
  @@index([dungeonId])
}

// Reusable live health state for Hunting and later PvE. Regeneration is derived
// lazily from HEALTH_REGEN whenever the state is read or damage is applied.
model CharacterHealth {
  userId        String   @id
  currentHealth Float
  regeneratedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([regeneratedAt])
}

// One active vocational activity per user.
// Progress is derived from timestamps; the server does not tick.
model UserVocationalActivity {
  id         Int                  @id @default(autoincrement())
  userId     String               @unique
  actionType VocationalActionType
  resourceId Int
  locationId Int?

  startedAt DateTime @default(now())
  endsAt    DateTime

  // Snapshot of effective unit time (after tool/buff modifiers at start)
  unitSeconds Int

  // For FISHING: which specific UserItem stack to consume as bait.
  baitUserItemId Int?

  // How many units have already been claimed/paid out
  unitsClaimed Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource     VocationalResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  location     Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  baitUserItem UserItem?          @relation("BaitUserItem", fields: [baitUserItemId], references: [id], onDelete: SetNull)

  @@index([endsAt])
  @@index([userId, endsAt])
  @@index([baitUserItemId])
}

// ============================================
// SETTLEMENTS, NPCS, QUESTS & COMMUNITY PROJECTS
// ============================================

enum SettlementKind {
  VILLAGE
  TOWN
  CITY
}

// A location's common ground: its NPCs (shops and quests) and community
// projects. A location can hold any number of settlements, and players must
// be at the location to use them.
model Settlement {
  id          Int            @id @default(autoincrement())
  locationId  Int
  name        String
  kind        SettlementKind @default(VILLAGE)
  description String?        @db.Text
  image       String?
  // Settlement map artwork (1536x1024) with its NPCs pinned on it.
  mapImage    String?
  // Pin on the location's region map, in percent; unplaced when null.
  mapX        Float?
  mapY        Float?
  enabled     Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  location Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  npcs     Npc[]
  projects CommunityProject[]
  storage  SettlementStorage?

  @@unique([locationId, name])
  @@index([locationId, enabled, sortOrder])
}

// Optional role that will grant an NPC services: blacksmiths offer rarity
// upgrades (and later repairs). The services themselves come later.
enum NpcProfession {
  BLACKSMITH
}

// NPCs are identified by name; a profession is optional.
model Npc {
  id                Int            @id @default(autoincrement())
  settlementId      Int
  name              String
  description       String?        @db.Text
  portrait          String?
  // The square of the portrait shown as the NPC's head on the settlement
  // map: its top-left corner (x of the width, y of the height) and its side
  // (of the width), as fractions. The default crop is used while unset.
  headX             Float?
  headY             Float?
  headSize          Float?
  // Pin on the settlement map, in percent; unplaced when null.
  mapX              Float?
  mapY              Float?
  profession        NpcProfession?
  // Hidden from players until this community project is completed.
  requiredProjectId Int?
  enabled           Boolean        @default(true)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  settlement      Settlement        @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  requiredProject CommunityProject? @relation("NpcUnlock", fields: [requiredProjectId], references: [id], onDelete: SetNull)
  offers          NpcOffer[]
  quests          Quest[]

  @@index([settlementId, enabled, sortOrder])
  @@index([requiredProjectId])
}

// An item an NPC sells at this NPC's own price, granted at the item's rarity.
// A rare find has an availability window and is hidden outside it.
model NpcOffer {
  id                Int       @id @default(autoincrement())
  npcId             Int
  itemId            Int
  price             Decimal   @db.Decimal(10, 2)
  availableFrom     DateTime?
  availableUntil    DateTime?
  requiredProjectId Int?
  enabled           Boolean   @default(true)
  sortOrder         Int       @default(0)

  npc             Npc               @relation(fields: [npcId], references: [id], onDelete: Cascade)
  item            Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  requiredProject CommunityProject? @relation("NpcOfferUnlock", fields: [requiredProjectId], references: [id], onDelete: SetNull)

  @@index([npcId, enabled, sortOrder])
  @@index([itemId])
  @@index([requiredProjectId])
}

enum QuestRepeat {
  ONCE
  DAILY
  WEEKLY
}

enum QuestObjectiveType {
  // Hand in items (any rarity) when completing the quest.
  DELIVER
  // Defeat a creature, in hunting grounds or dungeons, after accepting.
  HUNT
  // Clear a dungeon after accepting.
  CLEAR
}

model Quest {
  id                Int         @id @default(autoincrement())
  npcId             Int
  name              String
  description       String?     @db.Text
  repeat            QuestRepeat @default(ONCE)
  requiredLevel     Int         @default(1)
  rewardGold        Decimal     @default(0) @db.Decimal(10, 2)
  rewardXp          Int         @default(0)
  // Hidden from players until this community project is completed.
  requiredProjectId Int?
  enabled           Boolean     @default(true)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  npc             Npc               @relation(fields: [npcId], references: [id], onDelete: Cascade)
  requiredProject CommunityProject? @relation("QuestUnlock", fields: [requiredProjectId], references: [id], onDelete: SetNull)
  objectives      QuestObjective[]
  rewardItems     QuestRewardItem[]
  userQuests      UserQuest[]
  seenBy          UserSeenQuest[]

  @@index([npcId, enabled, sortOrder])
  @@index([requiredProjectId])
}

// The target column matches the type: itemId (DELIVER), creatureId (HUNT) or
// dungeonId (CLEAR).
model QuestObjective {
  id         Int                @id @default(autoincrement())
  questId    Int
  type       QuestObjectiveType
  itemId     Int?
  creatureId Int?
  dungeonId  Int?
  quantity   Int                @default(1)

  quest    Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  item     Item?     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  creature Creature? @relation(fields: [creatureId], references: [id], onDelete: Cascade)
  dungeon  Dungeon?  @relation(fields: [dungeonId], references: [id], onDelete: Cascade)

  @@index([questId])
  @@index([itemId])
  @@index([creatureId])
  @@index([dungeonId])
}

// Items granted at their own rarity when the quest is completed.
model QuestRewardItem {
  id       Int @id @default(autoincrement())
  questId  Int
  itemId   Int
  quantity Int @default(1)

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  item  Item  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([questId, itemId])
  @@index([itemId])
}

// A player's quest in one period: "ONCE" for one-time quests, the UTC day
// (2026-09-19) for daily quests and the UTC week's Monday (W2026-09-14) for
// weekly quests, so repeatable quests reset without a job.
model UserQuest {
  id          Int       @id @default(autoincrement())
  userId      String
  questId     Int
  period      String    @db.VarChar(16)
  // Kills and dungeon clears since accepting, keyed "creature:<id>" and
  // "dungeon:<id>", so editing objectives never orphans progress.
  progress    Json?
  acceptedAt  DateTime  @default(now())
  completedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, period])
  @@index([questId])
  @@index([userId, completedAt])
}

// One-time quests a player has had on screen at their NPC. Available ones
// without a row light up the new-quest dots (Settlements menu, settlement and
// NPC cards) where the player stands.
model UserSeenQuest {
  userId  String
  questId Int
  seenAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@id([userId, questId])
  @@index([questId])
}

// A settlement-wide goal every player contributes items to. Completing it
// reveals the NPCs, shop offers and quests that require it.
model CommunityProject {
  id           Int       @id @default(autoincrement())
  settlementId Int
  name         String
  description  String?   @db.Text
  image        String?
  enabled      Boolean   @default(true)
  sortOrder    Int       @default(0)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  settlement    Settlement                    @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  requirements  CommunityProjectRequirement[]
  unlocksNpcs   Npc[]                         @relation("NpcUnlock")
  unlocksOffers NpcOffer[]                    @relation("NpcOfferUnlock")
  unlocksQuests Quest[]                       @relation("QuestUnlock")

  @@index([settlementId, enabled, sortOrder])
}

model CommunityProjectRequirement {
  id          Int @id @default(autoincrement())
  projectId   Int
  itemId      Int
  quantity    Int
  // Total contributed by every player; contributions stop at quantity.
  contributed Int @default(0)

  project       CommunityProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  item          Item                           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  contributions CommunityProjectContribution[]

  @@unique([projectId, itemId])
  @@index([itemId])
}

// One row per player and requirement, summing their contributions.
model CommunityProjectContribution {
  id            Int      @id @default(autoincrement())
  requirementId Int
  userId        String
  quantity      Int
  updatedAt     DateTime @updatedAt

  requirement CommunityProjectRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  user        User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requirementId, userId])
  @@index([userId])
}

// ============================================
// SETTLEMENT STORAGE
// ============================================

// How every storage looks; one row (id 1). The chest artwork is shared by
// all of them, so a new settlement's storage needs no art of its own.
model StorageConfig {
  id        Int      @id @default(1)
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A settlement's storage: a pin on its map that a player rents once, with
// gold, and then keeps items in. Storage is never shared between
// settlements, and only reachable while the player is at its location.
model SettlementStorage {
  id           Int      @id @default(autoincrement())
  settlementId Int      @unique
  name         String   @default("Storage")
  description  String?  @db.Text
  // What renting it costs each player, once.
  unlockCost   Decimal  @default(0) @db.Decimal(10, 2)
  // How many stacks it holds. Extra slots per player come later.
  slots        Int      @default(10)
  // Pin on the settlement map, in percent; unplaced when null.
  mapX         Float?
  mapY         Float?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settlement Settlement    @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  players    UserStorage[]
}

// One player's storage in one settlement, created when they rent it. Its
// items are UserItem rows with status IN_STORAGE, one per slot in use.
model UserStorage {
  id         Int      @id @default(autoincrement())
  userId     String
  storageId  Int
  unlockedAt DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  storage SettlementStorage @relation(fields: [storageId], references: [id], onDelete: Cascade)
  items   UserItem[]

  @@unique([userId, storageId])
  @@index([storageId])
}

// ============================================
// NOTIFICATIONS & MESSAGES
// ============================================

// What a notification is about; players filter their list by it.
enum NotificationCategory {
  GENERAL
  SETTLEMENT
  QUEST
  MARKET
  COMBAT
  SYSTEM
}

// A one-way note from the game to one player. Only the newest
// `NOTIFICATIONS_KEPT` per player are held; older ones are pruned when the
// player opens their list.
model Notification {
  id        Int                  @id @default(autoincrement())
  userId    String
  category  NotificationCategory @default(GENERAL)
  title     String
  body      String               @db.Text
  // Optional "Read more" target, e.g. /settlements/3.
  href      String?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([userId, readAt])
}

// A private thread. Player threads hold exactly two participants; a system
// thread holds one, and its messages have no sender.
model Conversation {
  id            Int      @id @default(autoincrement())
  // One row per pair: the two user ids sorted and joined ("a|b"), or
  // "system|<userId>" for the game's own thread with a player.
  pairKey       String   @unique @db.VarChar(191)
  system        Boolean  @default(false)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
  reports      MessageReport[]

  @@index([lastMessageAt])
}

// One player's side of a thread. Deleting a conversation only hides this row,
// so the other player keeps theirs.
model ConversationParticipant {
  conversationId Int
  userId         String
  // Hidden after this player deleted the thread, or while they are at their
  // conversation limit and this one is waiting for a free slot.
  hidden         Boolean   @default(false)
  // New messages this player has not opened yet. Hidden + unread is a thread
  // waiting for room.
  unread         Boolean   @default(false)
  // Messages up to here stay hidden from this player after a delete.
  clearedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, hidden, unread])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  // Null when the game itself wrote it (a system message).
  senderId       String?
  body           String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([conversationId, id])
  @@index([senderId])
}

enum MessageReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// A reported thread, with the transcript copied in as it stood, so neither
// player can erase what moderators review.
model MessageReport {
  id             Int                 @id @default(autoincrement())
  conversationId Int?
  reporterId     String?
  reportedId     String?
  reason         String?             @db.Text
  // [{ at, sender, body }] at the moment of the report.
  transcript     Json
  status         MessageReportStatus @default(OPEN)
  reviewNote     String?             @db.Text
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reporter     User?         @relation("MessageReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reported     User?         @relation("MessageReportReported", fields: [reportedId], references: [id], onDelete: SetNull)
  reviewedBy   User?         @relation("MessageReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, id])
  @@index([conversationId])
  @@index([reporterId])
  @@index([reportedId])
  @@index([reviewedById])
}
