# Copy to `.env` next to docker-compose.yml on the host and fill in.
# All three services (app, daemon, migrate) read this one file.

# --- image ------------------------------------------------------------
# Override AERGYLE_TAG to pin or roll back to a specific build.
AERGYLE_IMAGE=ghcr.io/markomalec/aergyle
AERGYLE_TAG=latest

# --- where the containers publish ------------------------------------
# Loopback only, because Apache proxies to them. Change to 0.0.0.0:3000 if
# you ever run without a reverse proxy in front.
APP_BIND=127.0.0.1:3000
WS_BIND=127.0.0.1:3001

# --- database ---------------------------------------------------------
# On the Pi MariaDB is a host service, hence host.docker.internal.
# On a VPS with a containerised DB this becomes e.g. mysql://user:pass@db:3306/aergyle_game
DATABASE_URL="mysql://USER:PASSWORD@host.docker.internal:3306/aergyle_game"

# --- auth -------------------------------------------------------------
NEXTAUTH_URL="https://mmo.markomalec.com"
NEXTAUTH_SECRET=""  # openssl rand -base64 32 (at least 32 characters)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# /admin has its own accounts (username + password + authenticator code),
# separate from player accounts. Create the first one with:
#   npm run admin -- create <username>
# Discord sign-in needs this redirect URL registered in the Discord app:
#   https://mmo.markomalec.com/api/auth/callback/discord

# --- realtime ---------------------------------------------------------
# Shared secret the app signs WS tokens with and the daemon verifies.
REALTIME_TOKEN_SECRET=""
REALTIME_WS_PORT=3001
# How often the daemon looks for due ticks. 250ms is finer than any resource
# needs (the shortest unit is 9s); 1000 costs a quarter of the queries.
VOCATION_TICK_LOOP_MS=1000

# NOTE: NEXT_PUBLIC_REALTIME_WS_URL is NOT set here. Next inlines NEXT_PUBLIC_*
# into the browser bundle at build time, so it is a build argument in the
# GitHub workflow, not a runtime variable.
